---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer.astro';
import { getSiteContent } from '../../utils/content';
import { getCollection } from 'astro:content';

const content = await getSiteContent();

// Get all published case studies with date <= today, sorted by date (newest first)
const now = new Date();
const studies = (await getCollection('caseStudies'))
  .filter((study) => study.data.published && study.data.date <= now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    url: 'https://kamalakarheartcentre.com/case-study/',
    name: 'Patient Case Studies - Kamalakar Heart Centre',
    description: 'Anonymised educational case discussions from Kamalakar Heart Centre, Guntur, published with patient consent.',
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'Kamalakar Heart Centre',
      url: 'https://kamalakarheartcentre.com/',
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: studies.map((study, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://kamalakarheartcentre.com/case-study/${study.id}/`,
        name: study.data.title,
      })),
    },
  },
];
---

<BaseLayout class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans transition-colors duration-300">
  <SEO
    slot="head"
    title="Patient Case Studies | Educational Case Discussions, Guntur"
    description="Anonymised educational case discussions from Kamalakar Heart Centre, Guntur, published with patient consent."
    keywords={['heart treatment case study', 'angioplasty case study', 'cardiology case studies Guntur']}
    canonicalUrl="https://kamalakarheartcentre.com/case-study/"
    schemas={schemas}
    page="case-study"
  />

  <Header
    client:idle
    content={content.nav}
    appointmentPhone={content.contact.appointmentPhone}
    currentPage="case-study"
    currentPath={Astro.url.pathname}
  />

  <main id="main-content" aria-label="Case Studies">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-1">
      <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <li>
          <a href="/" class="hover:text-primary dark:hover:text-white transition-colors">Home</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="text-primary dark:text-white font-medium" aria-current="page">Case Studies</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="bg-gradient-to-br from-primary/5 to-transparent dark:from-primary/10 py-6 md:py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-primary/50 text-primary dark:text-white mb-3 md:mb-6 border border-gray-100 dark:border-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          <span class="text-sm font-bold uppercase tracking-wider">Educational Case Discussions</span>
        </div>
        <h1 class="text-[28px] md:text-5xl font-bold font-serif text-primary dark:text-white mb-6 leading-tight">
          Patient Case Studies
        </h1>
        <p class="text-base md:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed font-medium">
          Anonymised educational case discussions from Kamalakar Heart Centre, Guntur, published with patient consent. Each case describes how a heart condition was evaluated and treated; outcomes vary between patients.
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mt-4 italic">
          Patient-identifying information is withheld in every case study to protect privacy.
        </p>
      </div>
    </section>

    <!-- Case Studies Grid -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
      {studies.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-gray-500 dark:text-gray-400 text-lg">No case studies have been published yet.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-8">
          {studies.map((study) => (
            <a
              href={`/case-study/${study.id}/`}
              class="group bg-white dark:bg-gray-800 rounded-2xl overflow-hidden border border-gray-100 dark:border-gray-700 hover:shadow-xl hover:border-primary/20 transition-all duration-300 hover:-translate-y-1"
            >
              <div class="p-5 md:p-8">
                <div class="flex items-center gap-3 mb-4">
                  <time
                    datetime={study.data.date.toISOString()}
                    class="text-xs font-bold text-gray-400 uppercase tracking-wider"
                  >
                    {study.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>

                <h2 class="text-xl font-bold font-serif text-primary dark:text-white mb-3 group-hover:text-accent dark:group-hover:text-accent-light transition-colors leading-tight">
                  {study.data.title}
                </h2>

                <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4 md:mb-6 line-clamp-3">
                  {study.data.summary}
                </p>

                {study.data.tags && (
                  <div class="flex flex-wrap gap-2 mb-4 md:mb-6">
                    {study.data.tags.slice(0, 3).map((tag) => (
                      <span class="px-2.5 py-1 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs font-medium rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                    {study.data.author}
                  </span>
                  <span class="inline-flex items-center gap-1 text-sm font-bold text-primary dark:text-white group-hover:translate-x-1 transition-transform">
                    Read Case Study
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Health guidance (no booking CTA — NMC 8.1.v: case pages must not solicit) -->
    <section class="bg-primary dark:bg-primary-light py-6 md:py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-white mb-4">If You Have Chest Pain or Breathlessness</h2>
        <p class="text-white/80 max-w-2xl mx-auto">If you have chest pain or breathlessness, seek medical attention. In an emergency call 108.</p>
        <p class="text-white/80 max-w-2xl mx-auto mt-3 text-sm">
          Kamalakar Heart Centre, Guntur — phone:
          <a href={`tel:${content.contact.appointmentPhone}`} class="underline hover:text-white">{content.contact.appointmentPhone}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer content={content.footer} navContent={content.nav} currentPage="case-study" />
</BaseLayout>
