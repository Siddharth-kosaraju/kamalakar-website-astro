---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer.astro';
import MediaGallery from '../../components/MediaGallery';
import { getSiteContent } from '../../utils/content';
import { buildMediaListSchema, buildBreadcrumbSchema } from '../../utils/schemas';
import { extractYoutubeId, isShortUrl } from '../../utils/youtube';
import { getCollection } from 'astro:content';

const content = await getSiteContent();

const MEDIA_CATEGORIES = [
  'Heart Tests Explained',
  'Heart Attack & Emergency',
  'Prevention & Lifestyle',
  'Inside the Clinic',
];

// Admin-managed order (ascending) is authoritative; uploadDate only breaks
// ties among legacy/equal-order entries.
const entries = (await getCollection('media')).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  const da = a.data.uploadDate ? new Date(a.data.uploadDate).getTime() : 0;
  const db = b.data.uploadDate ? new Date(b.data.uploadDate).getTime() : 0;
  return db - da;
});

const items = entries.map((e) => ({
  slug: e.id,
  displayTitle: e.data.displayTitle,
  youtubeId: extractYoutubeId(e.data.youtubeUrl),
  category: e.data.category,
  language: e.data.language,
  tier: e.data.tier,
  description: e.data.description,
  keyPoints: e.data.keyPoints,
  isShort: isShortUrl(e.data.youtubeUrl),
  hasPage: e.data.tier === 'full' || e.data.tier === 'featured',
}));

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: 'https://kamalakarheartcentre.com/' },
    { name: 'Media', url: 'https://kamalakarheartcentre.com/media/' },
  ]),
  buildMediaListSchema(
    items.map((i) => ({
      slug: i.slug,
      displayTitle: i.displayTitle,
      youtubeId: i.youtubeId,
      description: i.description,
      uploadDate: entries.find((e) => e.id === i.slug)?.data.uploadDate,
    }))
  ),
];
---

<BaseLayout class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans transition-colors duration-300">
  <SEO
    slot="head"
    title="Heart Health Videos | Kamalakar Heart Centre, Guntur"
    description="Watch Dr. Kamalakar Kosaraju explain heart tests, heart attack warning signs, and prevention tips in short, easy-to-follow videos — in English and Telugu."
    keywords={['heart health videos guntur', 'cardiologist videos telugu', 'dr kamalakar kosaraju videos', 'heart attack symptoms video', 'ecg echo test video']}
    canonicalUrl="https://kamalakarheartcentre.com/media/"
    schemas={schemas}
    page="media"
  />

  <Header
    client:idle
    content={content.nav}
    appointmentPhone={content.contact.appointmentPhone}
    currentPage="media"
    currentPath={Astro.url.pathname}
  />

  <main id="main-content" aria-label="Main content">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 md:pt-28 pb-1">
      <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <li>
          <a href="/" class="hover:text-primary dark:hover:text-white transition-colors">Home</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="text-primary dark:text-white font-medium" aria-current="page">Media</li>
      </ol>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-6 md:pb-10">
      <h1 class="text-3xl md:text-5xl font-bold font-serif text-primary dark:text-white mb-3 md:mb-4">
        Heart Health Videos
      </h1>
      <p class="text-base md:text-lg text-secondary dark:text-gray-400 max-w-2xl">
        Short, plain-language videos from Dr. Kamalakar Kosaraju on heart tests, heart attack warning signs, and everyday prevention — in English and Telugu.
      </p>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
      <MediaGallery client:visible items={items} categories={MEDIA_CATEGORIES} />
    </div>

    <!-- CTA -->
    <section class="bg-primary dark:bg-primary-light py-8 md:py-12">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-white mb-6">
          Have Questions About Your Heart Health?
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={`tel:${content.contact.appointmentPhone}`}
            class="inline-flex items-center gap-3 bg-white text-primary px-6 py-3 md:px-8 md:py-4 rounded-xl font-bold text-base md:text-lg shadow-lg hover:bg-gray-100 transition-all hover:-translate-y-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {content.contact.appointmentPhone}
          </a>
          <a
            href="/services/"
            class="inline-flex items-center gap-2 text-white/90 hover:text-white font-bold transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
            View All Services
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer content={content.footer} navContent={content.nav} currentPage="media" />
</BaseLayout>
