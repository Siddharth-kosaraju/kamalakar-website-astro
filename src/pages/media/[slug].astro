---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer.astro';
import LiteYouTube from '../../components/LiteYouTube';
import { getSiteContent, getServicePage } from '../../utils/content';
import { buildVideoObjectSchema, buildBreadcrumbSchema } from '../../utils/schemas';
import { extractYoutubeId } from '../../utils/youtube';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('media');
  return entries
    .filter((e) => e.data.tier === 'full' || e.data.tier === 'featured')
    .map((e) => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params;
const content = await getSiteContent();
const entry = await getEntry('media', slug!);

if (!entry) {
  return Astro.redirect('/404');
}

const video = entry.data;
const youtubeId = extractYoutubeId(video.youtubeUrl);

// Defense in depth: the admin UI only offers real slugs via a dropdown, but
// the CMS API doesn't itself validate relatedService/relatedPost (it has no
// access to the site's content collections) — so a bad value written
// directly via the API must still fail the build loudly here, exactly like
// services/[slug].astro's relatedPosts check, rather than silently showing
// no related-content card.
const relatedService = video.relatedService ? await getServicePage(video.relatedService) : null;
if (video.relatedService && !relatedService) {
  throw new Error(
    `[media/${slug}] relatedService references "${video.relatedService}", which is not a real service page. ` +
    `Fix it via the admin portal or src/content/media/${slug}.yaml.`
  );
}

const now = new Date();
let relatedPost = null;
if (video.relatedPost) {
  const posts = (await getCollection('blog')).filter((p) => p.data.published && p.data.date <= now);
  relatedPost = posts.find((p) => p.id === video.relatedPost) || null;
  if (!relatedPost) {
    throw new Error(
      `[media/${slug}] relatedPost references blog slug "${video.relatedPost}", which is not a published post. ` +
      `Fix it via the admin portal or src/content/media/${slug}.yaml.`
    );
  }
}

// Other full-tier videos in the same category, for an "up next" rail.
const sameCategory = (await getCollection('media'))
  .filter((e) => e.id !== slug && e.data.category === video.category && (e.data.tier === 'full' || e.data.tier === 'featured'))
  .slice(0, 3);

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: 'https://kamalakarheartcentre.com/' },
    { name: 'Media', url: 'https://kamalakarheartcentre.com/media/' },
    { name: video.displayTitle, url: `https://kamalakarheartcentre.com/media/${slug}/` },
  ]),
  buildVideoObjectSchema({
    slug: slug!,
    displayTitle: video.displayTitle,
    youtubeId,
    description: video.description,
    uploadDate: video.uploadDate,
  }),
];
---

<BaseLayout class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans transition-colors duration-300">
  <SEO
    slot="head"
    title={`${video.displayTitle} | Kamalakar Heart Centre`}
    description={video.description || video.displayTitle}
    canonicalUrl={`https://kamalakarheartcentre.com/media/${slug}/`}
    schemas={schemas}
    page="media-video"
  />

  <Header
    client:idle
    content={content.nav}
    appointmentPhone={content.contact.appointmentPhone}
    currentPage="media"
    currentPath={Astro.url.pathname}
  />

  <main id="main-content" aria-label="Main content">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 md:pt-28 pb-1">
      <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 flex-wrap">
        <li>
          <a href="/" class="hover:text-primary dark:hover:text-white transition-colors">Home</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li>
          <a href="/media/" class="hover:text-primary dark:hover:text-white transition-colors">Media</a>
        </li>
        <li>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </li>
        <li class="text-primary dark:text-white font-medium truncate" aria-current="page">{video.displayTitle}</li>
      </ol>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 md:pb-24">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-accent mb-2">
        {video.category}{video.language === 'Telugu' && ' · తెలుగులో'}
      </span>
      <h1 class="text-2xl md:text-4xl font-bold font-serif text-primary dark:text-white mb-6 leading-tight">
        {video.displayTitle}
      </h1>

      <div class="aspect-video w-full rounded-2xl overflow-hidden shadow-2xl bg-black mb-8">
        <LiteYouTube client:load youtubeId={youtubeId} title={video.displayTitle} />
      </div>

      {video.description && (
        <p class="text-base md:text-lg text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
          {video.description}
        </p>
      )}

      {video.keyPoints && video.keyPoints.length > 0 && (
        <div class="bg-neutral-50 dark:bg-gray-800/50 rounded-2xl p-5 md:p-8 mb-8">
          <h2 class="text-lg font-bold text-primary dark:text-white mb-4">Key Points</h2>
          <ul class="space-y-3">
            {video.keyPoints.map((point) => (
              <li class="flex gap-3 text-gray-700 dark:text-gray-300">
                <span class="text-accent font-bold flex-shrink-0">•</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Related links -->
      {(relatedService || relatedPost) && (
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          {relatedService && (
            <a
              href={`/services/${video.relatedService}/`}
              class="flex-1 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl p-5 hover:shadow-lg hover:border-primary/20 transition-all"
            >
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Related Service</span>
              <p class="font-bold text-primary dark:text-white mt-1">{relatedService.title}</p>
            </a>
          )}
          {relatedPost && (
            <a
              href={`/blog/${relatedPost.id}/`}
              class="flex-1 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-xl p-5 hover:shadow-lg hover:border-primary/20 transition-all"
            >
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Related Guide</span>
              <p class="font-bold text-primary dark:text-white mt-1">{relatedPost.data.title}</p>
            </a>
          )}
        </div>
      )}

      <!-- Up next -->
      {sameCategory.length > 0 && (
        <div class="border-t border-gray-100 dark:border-gray-800 pt-8">
          <h2 class="text-lg font-bold text-primary dark:text-white mb-4">More in {video.category}</h2>
          <div class="grid sm:grid-cols-3 gap-4">
            {sameCategory.map((v) => (
              <a href={`/media/${v.id}/`} class="group">
                <div class="aspect-video w-full rounded-lg overflow-hidden bg-black mb-2">
                  <img
                    src={`https://img.youtube.com/vi/${extractYoutubeId(v.data.youtubeUrl)}/hqdefault.jpg`}
                    alt={v.data.displayTitle}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <p class="text-sm font-bold text-primary dark:text-white leading-snug group-hover:text-accent dark:group-hover:text-accent-light transition-colors">
                  {v.data.displayTitle}
                </p>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-10">
        <a href="/media/" class="inline-flex items-center gap-2 text-sm font-bold text-primary dark:text-white hover:text-accent dark:hover:text-accent-light transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Back to all videos
        </a>
      </div>
    </div>
  </main>

  <Footer content={content.footer} navContent={content.nav} currentPage="media" />
</BaseLayout>
